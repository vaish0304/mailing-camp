# ---- Resend ----
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The verified sender. Must be on a domain you verified in Resend.
FROM_EMAIL=campaigns@yourdomain.com
# Optional friendly name shown in the inbox ("AI Sales Assistant <campaigns@yourdomain.com>")
FROM_NAME=AI Sales Assistant
# Optional reply-to address
REPLY_TO=

# ---- Database (MongoDB Atlas) ----
# Atlas: Database > Connect > Drivers. Include the db name in the path.
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/mailing_camp?retryWrites=true&w=majority

# ---- API protection ----
# Any random string. The frontend must send it as "Authorization: Bearer <token>".
# If left blank, the API is unauthenticated (fine for local dev only).
ADMIN_TOKEN=

# ---- CORS ----
# Comma-separated list of allowed frontend origins. "*" allows all.
CORS_ORIGIN=http://localhost:5173

# ---- Optional: Resend webhook signing secret (whsec_...) ----
# Enables delivery/bounce/open tracking via POST /api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# ---- Sending behaviour ----
# Public base URL of this backend, used to build the unsubscribe link.
PUBLIC_BASE_URL=http://localhost:8080
# Daily campaign safety cap. A campaign may target a smaller batch, but never more than this total per UTC day.
DAILY_SEND_LIMIT=100
# ms to wait between individual emails. Keep at 1000 or higher.
BATCH_DELAY_MS=1000

PORT=8080
